DEBUG=True
SECRET_KEY=django-insecure-aso-marketplace-local-secret-key-change-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Settings
DB_ENGINE=django.db.backends.postgresql
DB_NAME=aso_db
DB_USER=aso_user
DB_PASSWORD=aso_password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=require

# Redis & Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Paystack Payment Gateway
PAYSTACK_SECRET_KEY=sk_test_mock_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_mock_paystack_public_key

# Cloudflare R2 / AWS S3 Storage
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key
AWS_STORAGE_BUCKET_NAME=aso-media-bucket
AWS_S3_ENDPOINT_URL=https://mock.r2.cloudflarestorage.com
